# Container image for QuickScribe movie subtitle burn on ECS Fargate.
# Build/push via: python scripts/setup_burn_subtitles_ecs.py --apply
FROM python:3.12-slim-bookworm

# Static ffmpeg with libass (ASS/SRT burn) + Hebrew-capable fonts.
ADD https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz /tmp/ffmpeg.tar.xz
RUN mkdir -p /opt/bin /opt/fonts \
    && apt-get update \
    && apt-get install -y --no-install-recommends xz-utils ca-certificates fonts-dejavu-core \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp \
    && cp /tmp/ffmpeg-*/bin/ffmpeg /opt/bin/ffmpeg \
    && chmod +x /opt/bin/ffmpeg \
    && rm -rf /tmp/ffmpeg.tar.xz /tmp/ffmpeg-* \
    && (cp -a /usr/share/fonts/truetype/dejavu /opt/fonts/ 2>/dev/null || true) \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/bin:${PATH}" \
    FFMPEG_PATH=/opt/bin/ffmpeg \
    BURN_FONTS_DIR=/opt/fonts \
    BURN_FFMPEG_TIMEOUT_SEC=1680 \
    BURN_ENGINE=ecs \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY burn_subtitles_lambda.py /app/burn_subtitles_lambda.py

# Site passes the burn payload via container env override BURN_TASK_JSON.
CMD ["python", "-u", "/app/burn_subtitles_lambda.py"]
