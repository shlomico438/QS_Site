# Cardcom — copy relevant lines to Koyeb / .env
#
# Three modes (pick one):
#
# 1) Local QuickScribe simulation (green page, no Cardcom API):
#    SIMULATION_MODE=true
#    CARDCOM_ENABLED=true
#
# 2) Production site + Cardcom SANDBOX (real Cardcom hosted page, test cards):
#    SIMULATION_MODE=false
#    CARDCOM_ENABLED=true
#    CARDCOM_SIMULATION=false
#    CARDCOM_SANDBOX=true
#    CARDCOM_TERMINAL_NUMBER=<terminal from Cardcom — must match API user>
#    CARDCOM_API_NAME=<API username from Cardcom merchant portal>
#    CARDCOM_API_PASSWORD=<API password from Cardcom merchant portal>
#    PUBLIC_BASE_URL=https://www.getquickscribe.com
#    Do NOT use random values: terminal + ApiName + password are issued together by Cardcom.
#
# 3) Production + Cardcom LIVE (real charges):
#    Same as (2) but production terminal from Cardcom, CARDCOM_SANDBOX=false
#
# Webhook (sandbox or live): https://<PUBLIC_BASE_URL>/api/cardcom/webhook
# Test card (sandbox): 4580000000000000 — see Cardcom developer docs for expiry/CVV.
#
# Invoices (חשבונית מס קבלה) at checkout — on by default in sandbox:
# CARDCOM_INVOICES=true
# CARDCOM_INVOICE_TYPE=TaxInvoiceAndReceipt
# CARDCOM_INVOICE_EMAIL=true
# Requires Documents model enabled on the Cardcom terminal (merchant portal).
#
# Unlimited monthly/annual (Hebrew Cardcom) creates a token on the first charge
# (ChargeAndCreateToken) and renews it with Transactions/Transaction.
# The terminal must allow token creation and recurring/direct-debit charges.
# Apply migrations/add_regular_cardcom_recurring.sql.
# Daily renewals are an EventBridge schedule, not a local script:
#   python scripts/setup_cardcom_renewal_schedule.py --apply
# The Lambda reads MEDICAL_BILLING_CRON_SECRET from the ECS task (or SSM)
# and POSTs /api/cardcom/run-renewals. Pay-per-use stays a one-time ChargeOnly payment.

SIMULATION_MODE=false
CARDCOM_ENABLED=true
CARDCOM_SIMULATION=false
CARDCOM_SANDBOX=true
CARDCOM_INVOICES=true
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
PUBLIC_BASE_URL=https://www.getquickscribe.com
